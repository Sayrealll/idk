---------------- TRACKER ----------------
local Tracker = NewSection(Tab5, "Egg Tracker", "radar")
local TrackerParagraph = Tracker:Paragraph({ Title = "Tracked Eggs (0)", Desc = "Scanning workspace for rendered eggs..." })

local function UpdateTracker()
    local counts, total = {}, 0
    for _, egg in ipairs(RenderedEggs:GetChildren()) do
        counts[egg.Name] = (counts[egg.Name] or 0) + 1
        total += 1
    end

    if total == 0 then
        TrackerParagraph:SetTitle("Tracked Eggs (0)")
        TrackerParagraph:SetDesc("No eggs currently rendered on map.")
        return
    end

    local names = {}
    for n in pairs(counts) do names[#names + 1] = n end
    table.sort(names, function(a, b) return (EggPriority[a] or 999) < (EggPriority[b] or 999) end)

    local lines = {}
    for _, n in ipairs(names) do lines[#lines + 1] = string.format("• %s (x%d)", n, counts[n]) end
    TrackerParagraph:SetTitle(string.format("Tracked Eggs (%d)", total))
    TrackerParagraph:SetDesc(table.concat(lines, "\n"))
end

Bind(RenderedEggs.ChildAdded, function() task.defer(UpdateTracker) end)
Bind(RenderedEggs.ChildRemoved, function() task.defer(UpdateTracker) end)
task.delay(1, UpdateTracker)

