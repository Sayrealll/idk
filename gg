    local hrp = GetHRP()
    local plot = GetMyPlot()
    if not hrp or not plot then return false end

    local base = plot:FindFirstChild("Baseplate")
    if not (base and base:IsA("BasePart")) then
        base = plot:FindFirstChildWhichIsA("BasePart", true)
    end
    if not base then return false end

    hrp.CFrame = base.CFrame * CFrame.new(0, 3, 0)
    return true
