local function FindSelectedEgg()
    local best, bestR, bestE = nil, math.huge, math.huge
    for _, egg in ipairs(RenderedEggs:GetChildren()) do
        local name = egg.Name
        local rarity = EggRarity(name)
        local byRarity = InList(Cfg.SelectedRarities, rarity)
        local byName = InList(Cfg.SelectedEggs, name)

        if byRarity or byName then
            local r = byRarity and (RarityPriority[rarity] or 99) or 999
            local e = byName and (EggPriority[name] or 999) or 9999
            if r < bestR or (r == bestR and e < bestE) then
                best, bestR, bestE = egg, r, e
            end
        end
    end
    return best
