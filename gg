local MAX_PLANTED_EGGS = 10 -- hard-coded guess, adjust if your plot allows more

local function RandomPlotPosition(base)
    local s, p = base.Size, base.Position
    local mx, mz = math.min(3, s.X / 4), math.min(3, s.Z / 4)
    local x = p.X - s.X / 2 + mx + math.random() * (s.X - 2 * mx)
    local z = p.Z - s.Z / 2 + mz + math.random() * (s.Z - 2 * mz)
    return Vector3.new(x, p.Y + s.Y / 2 + 1.5, z)
end

local function PlaceEggs()
    local targets = {}
    for _, tool in ipairs(GetTools()) do
        if Eggs_m[tool.Name] and EggMatches(tool.Name, Cfg.SelectedPlaceEgg, Cfg.SelectedPlaceRarities) then
            targets[#targets + 1] = tool
        end
    end
    if #targets == 0 then return end

    local plot = GetMyPlot()
    local base = plot and plot:FindFirstChild("Baseplate")
    local placed = FindPath(ReplicatedStorage, "Remotes", "Game", "EggPlaced")
    if not (base and base:IsA("BasePart") and placed) then return end

    for _, tool in ipairs(targets) do
        if not Cfg.AutoPlaceEgg then break end
        local folder = plot:FindFirstChild("Eggs")
        if folder and #folder:GetChildren() >= MAX_PLANTED_EGGS then break end

        if tool.Parent and EquipTool(tool, 0.5) then
            placed:FireServer({ PlantPosition = RandomPlotPosition(base) })
            task.wait(0.35)
        end
    end
end

