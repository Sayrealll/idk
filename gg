        if StockOf(category, item) > 0 then
            BuyWithCash:FireServer(category, item)
            local i = ShopStock[category][item]
            i.Amount = math.max(0, (tonumber(i.Amount) or 0) - 1)
            task.wait(0.2)
        end
    end
