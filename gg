local HIDE_VALUE = { Transparency = 1, CanCollide = false, Enabled = false }

local function HideProps(inst)
    if inst:IsA("BasePart") then return { "Transparency", "CanCollide" } end
    if inst:IsA("Decal") or inst:IsA("Texture") then return { "Transparency" } end
    if inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") or inst:IsA("ParticleEmitter")
        or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Fire") or inst:IsA("Smoke")
        or inst:IsA("Sparkles") or inst:IsA("Light") or inst:IsA("Highlight") then
        return { "Enabled" }
    end
end

local function ApplyHide(inst, state)
    local props = HideProps(inst)
    if not props then return end
    for _, prop in ipairs(props) do
        pcall(function()
            local key = "HideEgg_" .. prop
            if state then
                if inst:GetAttribute(key) == nil then inst:SetAttribute(key, inst[prop]) end
                inst[prop] = HIDE_VALUE[prop]
            else
                local orig = inst:GetAttribute(key)
                if orig ~= nil then inst[prop] = orig end
            end
        end)
    end
end

local function ToggleHideEggs(state)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    task.spawn(function()
        local n = 0
        for _, plot in ipairs(plots:GetChildren()) do
            local eggs = plot:FindFirstChild("Eggs")
            if eggs then
                for _, d in ipairs(eggs:GetDescendants()) do
                    ApplyHide(d, state)
                    n += 1
                    if n % 300 == 0 then task.wait() end
                end
            end
        end
    end)
end

do
    local function Attach(plot)
        task.spawn(function() -- one thread per plot so a slow plot doesn't block the rest
            local eggs = plot:WaitForChild("Eggs", 10)
            if not eggs or Unloaded then return end
            Bind(eggs.DescendantAdded, function(d)
                if Cfg.HideEggs then ApplyHide(d, true) end
            end)
        end)
    end

    task.spawn(function()
        local plots = workspace:WaitForChild("Plots", 10)
        if not plots then return end
        for _, p in ipairs(plots:GetChildren()) do Attach(p) end
        Bind(plots.ChildAdded, Attach)
    end)
end

OnUnload(function() ToggleHideEggs(false) end)

