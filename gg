local function IsEggReady(egg)
    local config = Eggs_m[egg.Name]
    local data = egg:FindFirstChild("EggData")
    local placeTime = data and data:FindFirstChild("PlaceTime")
    if not config or not placeTime or placeTime.Value <= 0 then return false end

    local weightObj = data:FindFirstChild("Weight")
    local weight = weightObj and tonumber(weightObj.Value) or 1
    local total = General_mData.GrowthTimeFor(config.GrowthTime, weight)
    local elapsed = egg:GetAttribute("FlatGrow") == true
        and (workspace:GetServerTimeNow() - placeTime.Value)
        or DayNight_m.GrowthElapsed(placeTime.Value)
    return total - elapsed <= 0
end

