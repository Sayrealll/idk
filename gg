local Servers = NewSection(Tab8, "Servers", "globe")

local function ServerHop()
    task.spawn(function()
        local ok, target = pcall(function()
            local candidates, cursor = {}, ""
            for _ = 1, 5 do
                local url = string.format(
                    "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100%s",
                    tostring(game.PlaceId),
                    cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
                )
                local data = HttpService:JSONDecode(game:HttpGet(url))
                for _, s in ipairs(data and data.data or {}) do
                    if s.id and s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                        candidates[#candidates + 1] = s
                    end
                end
                cursor = data and data.nextPageCursor or ""
                if cursor == "" then break end
            end
            table.sort(candidates, function(a, b) return a.playing < b.playing end)
            return candidates[1]
        end)

        if ok and target then
            Notify("Server Hop", string.format("Hopping to a server with %d player(s)...", target.playing))
            task.wait(0.5)
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, Player) end)
        else
            Notify("Server Hop", "Server hop failed, try again.", 4)
        end
    end)
end

Servers:Button({ Title = "Rejoin", Justify = "Center", Icon = "", Callback = function()
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player) end)
end })
Servers:Button({ Title = "Server Hop", Justify = "Center", Icon = "", Callback = ServerHop })
