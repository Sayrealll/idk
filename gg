local function CollectEgg(egg)
    if not (egg and egg.Parent) then return false end
    local snap = BasketSnapshot()
    local basketEgg
    local hrp = GetHRP()
    if not hrp then return false end

    if egg.Name == "Volcanic Egg" then
        hrp.CFrame = VOLCANO_1_CFRAME
        task.wait(0.1)
        TweenToCFrame(VOLCANO_2_CFRAME)
        task.wait(1)

        local part = GetEggPart(egg)
        hrp = GetHRP()
        if not (part and hrp) then return false end

        hrp.CFrame = part.CFrame * CFrame.new(0, 1.5, 0)
        task.wait(0.5)

        basketEgg = PickupAndConfirm(egg, snap)
        if not basketEgg then return false end
        task.wait(0.1)

        hrp = GetHRP()
        if not hrp then return false end
        hrp.CFrame = VOLCANO_2_CFRAME
        task.wait(0.5)
        TweenToCFrame(VOLCANO_1_CFRAME)
        task.wait(2)
    else
        if not TeleportToEgg(egg) then return false end
        task.wait(0.05)
        basketEgg = PickupAndConfirm(egg, snap)
        if not basketEgg then return false end
        task.wait(0.1)
    end

    VolcanoDip()
    TeleportToMyPlot()
    SendWebhook(egg.Name, basketEgg)
    task.wait(0.5)
    return true
end

