local ActiveESP = {}

local function RemoveESP(egg)
    local e = ActiveESP[egg]
    if e then e.Billboard:Destroy() ActiveESP[egg] = nil end
end

local function ClearESP()
    for egg in pairs(ActiveESP) do RemoveESP(egg) end
end

local function CreateESP(egg)
    local part = GetEggPart(egg)
    if not part then return nil end

    local bb = Instance.new("BillboardGui")
    bb.Name = "LunaEggESP"
    bb.Adornee = part
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = RarityColors[EggRarity(egg.Name)] or RarityColors.Common
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 16
    label.Text = egg.Name
    label.Parent = bb

    ActiveESP[egg] = { Billboard = bb, Label = label, Part = part }
    return ActiveESP[egg]
end

OnUnload(ClearESP)

Loop(0.1, function()
    if not Cfg.ESPEnabled then
        if next(ActiveESP) then ClearESP() end
        return 0.5
    end

    local hrp = GetHRP()
    for egg in pairs(ActiveESP) do
        if egg.Parent ~= RenderedEggs then RemoveESP(egg) end
    end

    for _, egg in ipairs(RenderedEggs:GetChildren()) do
        if EggMatches(egg.Name, Cfg.SelectedESPEggs, Cfg.SelectedESPRarities) then
            local esp = ActiveESP[egg] or CreateESP(egg)
            if esp and hrp then
                local d = math.floor((hrp.Position - esp.Part.Position).Magnitude)
                esp.Label.Text = string.format("%s\n[%dm]", egg.Name, d)
            end
        else
            RemoveESP(egg)
        end
    end
end)

