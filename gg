local function SendWebhook(eggName, basketEgg, force)
    if not force and not Cfg.WebhookEnabled then return end
    if Cfg.WebhookUrl == "" then return end

    local request = (syn and syn.request) or (http and http.request) or http_request
        or (fluxus and fluxus.request) or request
    if not request then return end

    local mutation, weight = "None", "Unknown"
    if basketEgg then
        mutation = basketEgg:GetAttribute("Mutation") or "None"
        weight = basketEgg:GetAttribute("Weight") or "Unknown"
    end

    local payload = HttpService:JSONEncode({
        username = "Luna Hub Notifier",
        embeds = {{
            title = "🥚 Egg Collected!",
            color = 65280,
            fields = {
                { name = "Player",   value = Player.Name,              inline = true },
                { name = "Egg Name", value = tostring(eggName),        inline = true },
                { name = "Rarity",   value = EggRarity(eggName),       inline = true },
                { name = "Mutation", value = tostring(mutation),       inline = true },
                { name = "Weight",   value = tostring(weight) .. " KG", inline = true },
            },
            footer = { text = "Luna Hub Auto Farm" },
            timestamp = DateTime.now():ToIsoDate(),
        }},
    })

    task.spawn(pcall, request, {
        Url = Cfg.WebhookUrl,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = payload,
    })
end

