local Saved = { Original = setmetatable({}, { __mode = "k" }) }
local FPSConn, Boosted = nil, false

local function SaveGraphics()
    Saved.GlobalShadows = Lighting.GlobalShadows
    Saved.FogEnd = Lighting.FogEnd
    Saved.ShadowSoftness = Lighting.ShadowSoftness
    Saved.Quality = settings().Rendering.QualityLevel
    Saved.MeshDetail = settings().Rendering.MeshPartDetailLevel
    if gethiddenproperty then
        pcall(function() Saved.Technology = gethiddenproperty(Lighting, "Technology") end)
    end
    local t = workspace:FindFirstChildOfClass("Terrain")
    if t then
        Saved.Water = { t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency }
    end
end

local function CleanInstance(inst)
    if not inst.Parent then return end
    pcall(function()
        if inst:IsA("BasePart") then
            if not Saved.Original[inst] then
                Saved.Original[inst] = { Material = inst.Material, Reflectance = inst.Reflectance }
                if inst:IsA("MeshPart") then Saved.Original[inst].RenderFidelity = inst.RenderFidelity end
            end
            if inst:IsA("MeshPart") then inst.RenderFidelity = Enum.RenderFidelity.Performance end
            inst.Material = Enum.Material.Plastic
            inst.Reflectance = 0
        elseif inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail")
            or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
            if not Saved.Original[inst] then Saved.Original[inst] = { Enabled = inst.Enabled } end
            inst.Enabled = false
        end
    end)
end

local function ApplyFPSBoost(state)
    if state == Boosted then return end
    Boosted = state

    if state then
        SaveGraphics()
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.ShadowSoftness = 0
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        if sethiddenproperty then pcall(sethiddenproperty, Lighting, "Technology", 2) end

        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then
            pcall(function()
                t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = 0, 0, 0, 0
                if sethiddenproperty then sethiddenproperty(t, "Decoration", false) end
            end)
        end
        if setfpscap then pcall(setfpscap, 1e6) end

        -- batched so the game doesn't freeze
        task.spawn(function()
            local n = 0
            for _, v in ipairs(game:GetDescendants()) do
                if not Boosted then return end
                CleanInstance(v)
                n += 1
                if n % 500 == 0 then task.wait() end
            end
        end)

        if FPSConn then FPSConn:Disconnect() end
        FPSConn = game.DescendantAdded:Connect(function(v)
            if Boosted then CleanInstance(v) end
        end)
    else
        if FPSConn then FPSConn:Disconnect() FPSConn = nil end
        pcall(function()
            Lighting.GlobalShadows = Saved.GlobalShadows
            Lighting.FogEnd = Saved.FogEnd
            Lighting.ShadowSoftness = Saved.ShadowSoftness
            settings().Rendering.QualityLevel = Saved.Quality
            settings().Rendering.MeshPartDetailLevel = Saved.MeshDetail
        end)
        if sethiddenproperty and Saved.Technology then
            pcall(sethiddenproperty, Lighting, "Technology", Saved.Technology)
        end
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t and Saved.Water then
            pcall(function()
                t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = table.unpack(Saved.Water)
            end)
        end
        if setfpscap then pcall(setfpscap, 60) end

        for inst, props in pairs(Saved.Original) do
            if inst.Parent then
                for prop, val in pairs(props) do pcall(function() inst[prop] = val end) end
            end
        end
        table.clear(Saved.Original)
    end
end

OnUnload(function() ApplyFPSBoost(false) end)

