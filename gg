-- Safe loop: fn may return a custom delay for the next tick
local function Loop(defaultDelay, fn)
    task.spawn(function()
        while not Unloaded do
            local ok, result = pcall(fn)
            if not ok then warn("[LunaHub]", result) end
            task.wait(ok and tonumber(result) or defaultDelay)
        end
    end)
end

-- FIFO lock so farm / sell / place / equip never fight over the character
local LockHeld, LockQueue = false, {}

local function Acquire(timeout)
    local ticket = {}
    table.insert(LockQueue, ticket)
    local start = os.clock()
    while LockHeld or LockQueue[1] ~= ticket do
        if os.clock() - start > timeout then
            local i = table.find(LockQueue, ticket)
            if i then table.remove(LockQueue, i) end
            return false
        end
        task.wait(0.05)
    end
    table.remove(LockQueue, 1)
    LockHeld = true
    return true
end

local function Locked(fn, ...)
    if not Acquire(60) then return nil end
    local ok, result = pcall(fn, ...)
    LockHeld = false
    if not ok then warn("[LunaHub]", result) end
    return result
end

-- Small utilities
local function Copy(v)
    if type(v) ~= "table" then return v end
    local t = {}
    for k, x in pairs(v) do t[k] = Copy(x) end
    return t
end

local function InList(list, value)
    if type(list) == "table" then
        for _, v in ipairs(list) do
            if v == value then return true end
        end
        return false
    end
    return list ~= nil and list ~= "" and list == value
end

local function FindPath(root, ...)
    local o = root
    for _, n in ipairs({ ... }) do
        o = o and o:FindFirstChild(n)
    end
    return o
end

