local function MaxPetCapacity()
    local calc = 5 + math.floor(Rebirths.Value or 0)
    local attr = Player:GetAttribute("MaxPets")
    return (attr and attr > 0) and math.max(attr, calc) or calc
end

local function PetIncome(tool)
    local config = Pets_m[PetNameOf(tool)]
    local base = config and tonumber(config.Income) or 0
    if base <= 0 then return 0 end

    local weight = tonumber(tool:GetAttribute("Weight")) or 1
    local factor = Mutations_m.CombinedFactor
        and Mutations_m.CombinedFactor(tool:GetAttribute("Mutation"), tool:GetAttribute("SpawnMutation")) or 1
    local standard = PetAging_m.WeightStandardKG or 1
    return math.floor(math.floor(base * (weight / standard)) * factor)
end

local function GetAllPetsSorted()
    local list = {}

    for _, p in pairs(PetRenderer_m.GetAll()) do
        if p.OwnerUserId == Player.UserId and p.Model and p.Model.Parent then
            list[#list + 1] = {
                Key = p.PetKey,
                Income = tonumber(p.DisplayIncome) or tonumber(p.Income) or 0,
                Placed = true,
                Position = p.Model:GetPivot().Position,
            }
        end
    end

    for _, tool in ipairs(GetTools()) do
        local key = tool:GetAttribute("PetKey")
        if key then
            list[#list + 1] = { Key = key, Income = PetIncome(tool), Placed = false, Tool = tool }
        end
    end

    -- tie-break on key so equal pets don't swap back and forth every cycle
    table.sort(list, function(a, b)
        if a.Income ~= b.Income then return a.Income > b.Income end
        return tostring(a.Key) < tostring(b.Key)
    end)
    return list
end

local function PlacementPos(root, index)
    local pos = (root.CFrame * CFrame.new(((index - 1) % 3 - 1) * 4, 0, -(math.floor((index - 1) / 3) * 4 + 8))).Position
    local plot = GetMyPlot()
    local base = plot and plot:FindFirstChild("Baseplate")
    if not base then return pos end

    local o = base.CFrame:PointToObjectSpace(pos)
    local sx, sz = base.Size.X / 2 - 2, base.Size.Z / 2 - 2
    return base.CFrame:PointToWorldSpace(Vector3.new(math.clamp(o.X, -sx, sx), o.Y, math.clamp(o.Z, -sz, sz)))
end

local function SellingActive() return Cfg.AutoSellPet or Cfg.AutoSellAllPets end

local function PlaceBestPets()
    if SellingActive() then return end
    local char = GetCharacter()
    if not char then return end
    local hum, root = char:FindFirstChildOfClass("Humanoid"), char.HumanoidRootPart
    if hum.Health <= 0 then return end

    local all = GetAllPetsSorted()
    if #all == 0 then return end

    local count = math.min(MaxPetCapacity(), #all)
    local best, bestKeys = {}, {}
    for i = 1, count do best[i] = all[i] bestKeys[all[i].Key] = true end

    local freed = {}
    for _, pet in ipairs(all) do
        if pet.Placed and not bestKeys[pet.Key] then
            freed[#freed + 1] = pet.Position
            PetRenderer_m.Remove(Player.UserId, pet.Key)
            PickupPetRemote:FireServer(pet.Key)
            task.wait(0.2)
        end
    end

    for slot, pet in ipairs(best) do
        if SellingActive() then break end
        if not pet.Placed then
            local tool = pet.Tool
            if not (tool and tool.Parent) then
                for _, t in ipairs(GetTools()) do
                    if t:GetAttribute("PetKey") == pet.Key then tool = t break end
                end
            end
            if tool and EquipTool(tool, 2) then
                PlacePetRemote:FireServer(pet.Key, table.remove(freed, 1) or PlacementPos(root, slot))
                task.wait(0.2)
            end
        end
    end

    if Player:GetAttribute("IsRiding") ~= true and not SellingActive() then
        hum:UnequipTools()
    end
end

Loop(0.5, function()
    if Cfg.AutoEquipBestPet and not SellingActive() then
        Locked(PlaceBestPets)
        return 10
    end
end)

