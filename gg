local function CanRebirth()
    local cap = tonumber(Rebirths_m.Cap)
    if cap and Rebirths.Value >= cap then return false end
    if Cash.Value < Rebirths_m.GetCost(Rebirths.Value) then return false end

    local reqList = General_m.RebirthRequirements
    if not reqList then return true end
    local required = reqList[math.clamp(Rebirths.Value + 1, 1, math.max(#reqList, 1))]
    if not required then return true end

    if PetRenderer_m and PetRenderer_m.GetAll then
        for _, v in pairs(PetRenderer_m.GetAll()) do
            if v.OwnerUserId == Player.UserId and v.Model and v.Model.Parent and v.Model.Name == required then
                return true
            end
        end
    end

    for _, tool in ipairs(GetTools()) do
        if string.find(tool.Name, required, 1, true) then return true end -- plain find: no pattern surprises
    end

    local hrp = GetHRP()
    local joint = hrp and hrp:FindFirstChild("PetMountJoint")
    local mounted = joint and joint.Part1 and joint.Parent
    if mounted then
        local name = mounted:GetAttribute("PetName") or mounted.Name
        if string.find(name, required, 1, true) then return true end
    end
    return false
end

